# ==========================================
# Server Configuration
# ==========================================

# Port the Plex Rewind server listens on.
PORT=3001

# Public URL used for links in emails and redirects.
BASE_URL=http://rewind.example.com


# ==========================================
# Plex Configuration
# ==========================================

# Unique application identifier used when communicating with Plex.
# Generate your own client ID for your deployment.
PLEX_CLIENT_ID=

# URL of your Plex Media Server.
PLEX_URL=http://127.0.0.0:32400

# Plex authentication token.
# See the Plex documentation for instructions on finding your token.
PLEX_TOKEN=


# ==========================================
# Rewind Configuration
# ==========================================

# Annual rewind release date (MM-DD).
# Rewinds for the year are generated and released on this date.
YEAR_RELEASE=12-01


# ==========================================
# Email / SMTP Configuration
# ==========================================

# SMTP server hostname.
SMTP_HOST=mail.example.com

# SMTP port (587 for STARTTLS, 465 for implicit TLS).
SMTP_PORT=587

# Enable implicit TLS (true for port 465, false for port 587).
SMTP_TLS=false

# SMTP authentication credentials.
SMTP_USER=
SMTP_PASSWORD=

# Sender name and email address displayed to recipients.
MAIL_FROM="Plex Rewind <user@example.com>"
